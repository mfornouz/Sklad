<Window x:Class="Sklad.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sklad.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Image Source="/Images/Gemini_Generated_Image_7bl24q7bl24q7bl2.jpg" Height="100" Margin="5"/>
            <TextBlock Text="Skladový systém" FontSize="16"
                       HorizontalAlignment="Center"
                       FontWeight="Bold" Margin="5"/>
        </StackPanel>

        <Border BorderBrush="AliceBlue" BorderThickness="5" Grid.Row="1" Background="LightGray"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Tabulky" Margin="15" FontSize="16" FontWeight="Bold">

                <StackPanel>

                    <Button Margin="10" Padding="10">
                       <StackPanel>
                        <Image Source="/Images/MainMenu/material.png" Width="48"/>
                        <TextBlock Text="Materiál" FontSize="14" HorizontalAlignment="Center"/>
                       </StackPanel>
                    </Button>

                </StackPanel>
                
            </GroupBox>
            
            
        </Grid>

        <TextBlock Text="Připraven" Margin="5" FontSize="12" Grid.Row="2"/>


        <!--<Button Content="Click Me" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
        <Image HorizontalAlignment="Left" Height="100" Margin="98,108,0,0" VerticalAlignment="Top" Width="100" Source="/Images/Icons/Add.png"/>-->


    </Grid>
</Window>
